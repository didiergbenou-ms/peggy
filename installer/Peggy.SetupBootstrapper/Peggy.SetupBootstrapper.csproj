<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>peggy-setup</AssemblyName>
    <RootNamespace>Peggy.SetupBootstrapper</RootNamespace>
    <ApplicationIcon>..\..\src\Peggy.Tray\Assets\Peggy.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <CopilotSkipCliDownload>true</CopilotSkipCliDownload>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.BootstrapperApplicationApi" Version="6.0.2" />
    <ProjectReference Include="..\..\src\Peggy.Tray\Peggy.Tray.csproj" />
    <Compile Include="..\Peggy.PrerequisiteCheck\PrerequisiteEngine.cs" Link="PrerequisiteEngine.cs" />
    <Compile Include="..\Peggy.PrerequisiteCheck\PrerequisiteInstall.cs" Link="PrerequisiteInstall.cs" />
    <Compile Include="..\Peggy.PrerequisiteCheck\InteractiveIdentity.cs" Link="InteractiveIdentity.cs" />
  </ItemGroup>
</Project>
