<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Bundle
      Name="Peggy"
      Manufacturer="Didier Gbenou"
      Version="$(var.BundleVersion)"
      UpgradeCode="{30D151DF-BE3F-5276-931A-FC933C8824A7}"
      AboutUrl="https://github.com/didiergbenou-ms/peggy"
      HelpUrl="https://github.com/didiergbenou-ms/peggy#troubleshooting"
      IconSourceFile="$(var.IconPath)"
      DisableModify="yes"
      Compressed="yes">
    <BootstrapperApplication SourceFile="$(var.BootstrapperPath)">
      <PayloadGroupRef Id="PeggyBootstrapperPayloads" />
    </BootstrapperApplication>
    <Chain>
      <MsiPackage
          Id="PeggyMsi"
          SourceFile="$(var.MsiPath)"
          Name="peggy-win-x64.msi"
          DisplayName="Peggy"
          Visible="no"
          Vital="yes">
        <MsiProperty Name="PEGGY_BUNDLE" Value="1" />
      </MsiPackage>
    </Chain>
  </Bundle>
</Wix>
