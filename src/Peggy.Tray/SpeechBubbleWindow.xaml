<Window x:Class="Peggy.Tray.SpeechBubbleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Topmost="True"
        ShowInTaskbar="False" ShowActivated="False"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        IsHitTestVisible="False">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="PeggyTheme.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>
  <StackPanel x:Name="Root" RenderTransformOrigin="0.82,1.0">
    <StackPanel.RenderTransform>
      <ScaleTransform x:Name="BubbleScale" ScaleX="1" ScaleY="1"/>
    </StackPanel.RenderTransform>
    <Border Background="{StaticResource PeggySurfaceBrush}"
            BorderBrush="{StaticResource PeggyBorderBrush}"
            BorderThickness="1"
            CornerRadius="16"
            MaxWidth="290"
            Margin="8,8,8,0"
            Effect="{StaticResource PeggyCardShadow}">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="5"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Background="{StaticResource PeggyBrandBrush}"
                CornerRadius="16,0,0,16"/>
        <StackPanel Grid.Column="1" Margin="13,10,15,12">
          <TextBlock Text="PEGGY"
                     Foreground="{StaticResource PeggyBrandBrush}"
                     FontFamily="Segoe UI"
                     FontWeight="SemiBold"
                     FontSize="9"/>
          <TextBlock x:Name="Text"
                     TextWrapping="Wrap"
                     FontFamily="Segoe UI"
                     FontSize="13.5"
                     Foreground="{StaticResource PeggyTextBrush}"
                     LineHeight="19"
                     Margin="0,3,0,0"/>
        </StackPanel>
      </Grid>
    </Border>
    <Path Fill="{StaticResource PeggySurfaceBrush}"
          Stroke="{StaticResource PeggyBorderBrush}"
          StrokeThickness="1"
          HorizontalAlignment="Right"
          Margin="0,-1,30,0"
          Data="M0,0 L16,0 L8,11 Z"/>
  </StackPanel>
</Window>
