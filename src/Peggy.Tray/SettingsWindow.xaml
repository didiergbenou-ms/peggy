<Window x:Class="Peggy.Tray.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Assistant settings" Width="680" Height="860"
        MinWidth="560" MinHeight="700"
        WindowStartupLocation="CenterOwner"
        Background="#f4f1ec">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold"
                 Foreground="#513b32"/>
      <TextBlock Text="The Microsoft 365 account is pinned in encrypted local state."
                 Foreground="#6f625b" Margin="0,4,0,16"/>
    </StackPanel>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Margin="0,0,0,14">
      <StackPanel>
        <StackPanel Margin="0,0,0,14">
          <TextBlock Text="Pinned Copilot model" FontWeight="SemiBold"/>
          <TextBox x:Name="ModelText" Margin="0,5,0,0" Padding="8"/>
        </StackPanel>

        <StackPanel Margin="0,0,0,14">
          <TextBlock Text="Additional Outlook folders" FontWeight="SemiBold"/>
          <TextBlock Text="One Inbox-relative folder path per line. Descendants are included."
                     Foreground="#6f625b" FontSize="11" Margin="0,2,0,5"/>
          <TextBox x:Name="FoldersText" Height="82" AcceptsReturn="True"
                   VerticalScrollBarVisibility="Auto" Padding="8"/>
        </StackPanel>

        <GroupBox Header="Local voice (English only)"
                  Padding="10" Margin="0,0,0,14">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <CheckBox x:Name="SpeechEnabledCheck" Grid.ColumnSpan="4"
                      Content="Enable local speech"
                      Margin="0,0,0,8"/>
            <TextBlock Grid.Row="1" Text="Models" VerticalAlignment="Center"
                       Margin="0,0,8,7"/>
            <TextBox x:Name="SpeechModelsText" Grid.Row="1" Grid.Column="1"
                     Grid.ColumnSpan="3" Padding="7" Margin="0,0,0,7"/>
            <TextBlock Grid.Row="2" Text="Voice" VerticalAlignment="Center"
                       Margin="0,0,8,7"/>
            <ComboBox x:Name="SpeechVoice" Grid.Row="2" Grid.Column="1"
                      Margin="0,0,12,7" Padding="6">
              <ComboBoxItem Content="Bella (warm)" Tag="0"/>
              <ComboBoxItem Content="Luna (bright)" Tag="2"/>
              <ComboBoxItem Content="Rosie (clear)" Tag="4"/>
              <ComboBoxItem Content="Kiki (lively)" Tag="6"/>
            </ComboBox>
            <TextBlock Grid.Row="2" Grid.Column="2" Text="CPU threads"
                       VerticalAlignment="Center" Margin="0,0,8,7"/>
            <ComboBox x:Name="SpeechThreads" Grid.Row="2" Grid.Column="3"
                      Margin="0,0,0,7" Padding="6">
              <ComboBoxItem Content="1"/>
              <ComboBoxItem Content="2"/>
              <ComboBoxItem Content="4"/>
              <ComboBoxItem Content="8"/>
            </ComboBox>
            <TextBlock Grid.Row="3" Text="Mic gain" VerticalAlignment="Center"
                       Margin="0,0,8,7"/>
            <ComboBox x:Name="SpeechInputGain" Grid.Row="3" Grid.Column="1"
                      Margin="0,0,12,7" Padding="6">
              <ComboBoxItem Content="4x" Tag="4"/>
              <ComboBoxItem Content="8x" Tag="8"/>
              <ComboBoxItem Content="12x" Tag="12"/>
              <ComboBoxItem Content="16x" Tag="16"/>
            </ComboBox>
            <TextBlock Grid.Row="4" Grid.ColumnSpan="4"
                       Text="Raw microphone audio stays in the isolated local speech process. Ending the conversation unloads every model."
                       TextWrapping="Wrap" Foreground="#6f625b" FontSize="11"/>
          </Grid>
        </GroupBox>

        <GroupBox Header="Monitoring schedule" Padding="10"
                  Margin="0,0,0,14">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="90"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="90"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <CheckBox x:Name="ScheduleEnabledCheck" Grid.ColumnSpan="5"
                      Content="Let the assistant sleep outside monitoring hours"
                      Margin="0,0,0,9"
                      Checked="ScheduleEnabledCheck_Changed"
                      Unchecked="ScheduleEnabledCheck_Changed"/>
            <TextBlock Grid.Row="1" Text="Wake" VerticalAlignment="Center"
                       Margin="0,0,7,0"/>
            <TextBox x:Name="WakeTimeText" Grid.Row="1" Grid.Column="1"
                     MaxLength="5" Padding="7"/>
            <TextBlock Grid.Row="1" Grid.Column="2" Text="Sleep"
                       VerticalAlignment="Center" Margin="18,0,7,0"/>
            <TextBox x:Name="SleepTimeText" Grid.Row="1" Grid.Column="3"
                     MaxLength="5" Padding="7"/>
            <TextBlock Grid.Row="2" Grid.ColumnSpan="5"
                       Text="Use local 24-hour time (HH:mm). Check now and Talk remain available while sleeping."
                       TextWrapping="Wrap" Foreground="#6f625b"
                       FontSize="11" Margin="0,7,0,0"/>
          </Grid>
        </GroupBox>

        <StackPanel Margin="0,0,0,14">
          <CheckBox x:Name="StartupCheck"
                    Content="Start the assistant at Windows sign-in"
                    Margin="0,0,0,7"/>
          <CheckBox x:Name="PausedCheck" Content="Pause monitoring"/>
        </StackPanel>

        <GroupBox Header="Full-channel watchlist" Padding="10">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="ChannelStatus"
                       Text="Loading joined Teams channels..."
                       Foreground="#6f625b" Margin="0,0,0,8"/>
            <ScrollViewer Grid.Row="1" MaxHeight="230"
                          VerticalScrollBarVisibility="Auto">
              <StackPanel x:Name="ChannelsPanel"/>
            </ScrollViewer>
          </Grid>
        </GroupBox>
      </StackPanel>
    </ScrollViewer>

    <StackPanel Grid.Row="2" Orientation="Horizontal"
                HorizontalAlignment="Right">
      <Button Content="Cancel" Width="90" Padding="10,6"
              Margin="0,0,8,0" Click="Cancel_Click"/>
      <Button Content="Save" Width="90" Padding="10,6"
              IsDefault="True" Click="Save_Click"/>
    </StackPanel>
  </Grid>
</Window>
