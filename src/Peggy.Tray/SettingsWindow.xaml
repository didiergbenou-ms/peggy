<Window x:Class="Peggy.Tray.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Peggy.Tray"
        Title="Peggy settings" Width="760" Height="820"
        MinWidth="620" MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PeggyPageBrush}"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="PeggyTheme.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <Style x:Key="SettingsLabelStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource PeggyTextBrush}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/>
      </Style>
      <Style x:Key="SettingsHintStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource PeggyMutedTextBrush}"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
      </Style>
    </ResourceDictionary>
  </Window.Resources>

  <Grid Background="{StaticResource PeggyPageBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{StaticResource PeggyHeaderBrush}"
            Padding="24,19">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Width="46" Height="46" CornerRadius="23"
                Background="#F4864F" Margin="0,0,13,0">
          <local:DecorativeTextBlock
              Text="P" Foreground="#513B32"
              FontSize="21" FontWeight="Bold"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"/>
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="Settings" FontSize="23"
                     FontWeight="SemiBold" Foreground="White"/>
          <TextBlock
              Text="Tune how Peggy connects, listens, and monitors your work"
              Foreground="#EADFD8" FontSize="12" Margin="0,3,0,0"/>
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  PanningMode="VerticalOnly">
      <StackPanel Margin="24,18,24,24">
        <GroupBox Header="Microsoft 365 connection"
                  Margin="0,0,0,16">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock x:Name="AccountStatus"
                         FontWeight="SemiBold"
                         Foreground="{StaticResource PeggyTextBrush}"/>
              <TextBlock
                  Text="Reconnect the current account or switch to another verified Microsoft 365 identity."
                  Style="{StaticResource SettingsHintStyle}"
                  Margin="0,4,16,0"/>
            </StackPanel>
            <Button x:Name="AccountConnectionButton"
                    Grid.Column="1"
                    Content="Change or reconnect"
                    Style="{StaticResource PeggySecondaryButtonStyle}"
                    VerticalAlignment="Center"
                    Click="SignInAgain_Click"/>
          </Grid>
        </GroupBox>

        <GroupBox Header="GitHub Copilot" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="Pinned Copilot model"
                       Style="{StaticResource SettingsLabelStyle}"/>
            <Grid Margin="0,6,0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <ComboBox x:Name="ModelCombo"
                        DisplayMemberPath="DisplayName"
                        SelectedValuePath="Id"
                        AutomationProperties.Name="Pinned Copilot model"
                        IsTextSearchEnabled="True"
                        MinHeight="32"
                        SelectionChanged="ModelCombo_SelectionChanged"/>
              <Button x:Name="RefreshModelsButton"
                      Grid.Column="1"
                      Content="Refresh"
                      Style="{StaticResource PeggySecondaryButtonStyle}"
                      Margin="10,0,0,0"
                      Padding="13,5"
                      Click="RefreshModels_Click"/>
            </Grid>
            <TextBlock x:Name="ModelStatusText"
                       Style="{StaticResource SettingsHintStyle}"
                       Margin="0,0,0,10"
                       AutomationProperties.LiveSetting="Polite"/>
            <Grid Margin="0,0,0,4">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="18"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="Reasoning effort"
                           Style="{StaticResource SettingsLabelStyle}"/>
                <ComboBox x:Name="ReasoningEffortCombo"
                          DisplayMemberPath="DisplayName"
                          SelectedValuePath="Value"
                          AutomationProperties.Name="Reasoning effort"
                          Margin="0,6,0,0"/>
              </StackPanel>
              <StackPanel Grid.Column="2">
                <TextBlock Text="Context tier"
                           Style="{StaticResource SettingsLabelStyle}"/>
                <ComboBox x:Name="ContextTierCombo"
                          DisplayMemberPath="DisplayName"
                          SelectedValuePath="Value"
                          AutomationProperties.Name="Context tier"
                          Margin="0,6,0,0"/>
              </StackPanel>
            </Grid>
            <TextBlock x:Name="ModelCapabilitiesText"
                       Style="{StaticResource SettingsHintStyle}"
                       Margin="0,0,0,2"/>
          </StackPanel>
        </GroupBox>

        <GroupBox Header="Outlook monitoring" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock
                Text="Inbox messages are always monitored. Inbox/Cases/Active starts selected for compatibility, but can be removed like any other folder. Selecting a folder includes all its descendants."
                Style="{StaticResource SettingsHintStyle}"
                Margin="0,0,0,10"/>
            <CheckBox x:Name="AllInboxFoldersCheck"
                      Content="Include every Inbox subfolder"
                      AutomationProperties.Name="Include every Inbox subfolder"
                      FontWeight="SemiBold"
                      Margin="0,0,0,10"
                      Checked="AllInboxFoldersCheck_Changed"
                      Unchecked="AllInboxFoldersCheck_Changed"/>
            <TextBlock x:Name="OutlookFolderStatus"
                       Text="Loading Outlook folders..."
                       Style="{StaticResource SettingsHintStyle}"
                       Margin="0,0,0,12"/>
            <TextBlock x:Name="SelectedOutlookFolderStatus"
                       Text="Selected additional folders"
                       Style="{StaticResource SettingsLabelStyle}"
                       Margin="0,0,0,6"/>
            <StackPanel x:Name="SelectedOutlookFoldersPanel"
                        Margin="0,0,0,13"/>
            <TextBlock Text="Mailbox folders"
                       Style="{StaticResource SettingsLabelStyle}"
                       Margin="0,0,0,6"/>
            <Border Background="{StaticResource PeggySoftSurfaceBrush}"
                    BorderBrush="{StaticResource PeggyBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="10">
              <ScrollViewer MaxHeight="280"
                            VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="OutlookFoldersPanel"/>
              </ScrollViewer>
            </Border>
          </StackPanel>
        </GroupBox>

        <GroupBox Header="Local voice (English only)"
                  Margin="0,0,0,16">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="150"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <CheckBox x:Name="SpeechEnabledCheck"
                      Grid.ColumnSpan="4"
                      Content="Enable local speech"
                      FontWeight="SemiBold"
                      Margin="0,0,0,12"/>
            <TextBlock Grid.Row="1" Text="Models"
                       VerticalAlignment="Center"
                       Style="{StaticResource SettingsLabelStyle}"
                       Margin="0,0,10,9"/>
            <TextBox x:Name="SpeechModelsText"
                     Grid.Row="1" Grid.Column="1"
                     Grid.ColumnSpan="3"
                     AutomationProperties.Name="Speech model directory"
                     Margin="0,0,0,9"/>
            <TextBlock Grid.Row="2" Text="Voice"
                       VerticalAlignment="Center"
                       Style="{StaticResource SettingsLabelStyle}"
                       Margin="0,0,10,9"/>
            <ComboBox x:Name="SpeechVoice"
                      Grid.Row="2" Grid.Column="1"
                      AutomationProperties.Name="Voice"
                      Margin="0,0,14,9">
              <ComboBoxItem Content="Bella (warm)" Tag="0"/>
              <ComboBoxItem Content="Luna (bright)" Tag="2"/>
              <ComboBoxItem Content="Rosie (clear)" Tag="4"/>
              <ComboBoxItem Content="Kiki (lively)" Tag="6"/>
            </ComboBox>
            <TextBlock Grid.Row="2" Grid.Column="2"
                       Text="CPU threads"
                       VerticalAlignment="Center"
                       Style="{StaticResource SettingsLabelStyle}"
                       Margin="0,0,10,9"/>
            <ComboBox x:Name="SpeechThreads"
                      Grid.Row="2" Grid.Column="3"
                      AutomationProperties.Name="CPU threads"
                      Margin="0,0,0,9">
              <ComboBoxItem Content="1"/>
              <ComboBoxItem Content="2"/>
              <ComboBoxItem Content="4"/>
              <ComboBoxItem Content="8"/>
            </ComboBox>
            <TextBlock Grid.Row="3" Text="Mic gain"
                       VerticalAlignment="Center"
                       Style="{StaticResource SettingsLabelStyle}"
                       Margin="0,0,10,9"/>
            <ComboBox x:Name="SpeechInputGain"
                      Grid.Row="3" Grid.Column="1"
                      AutomationProperties.Name="Microphone gain"
                      Margin="0,0,14,9">
              <ComboBoxItem Content="4x" Tag="4"/>
              <ComboBoxItem Content="8x" Tag="8"/>
              <ComboBoxItem Content="12x" Tag="12"/>
              <ComboBoxItem Content="16x" Tag="16"/>
            </ComboBox>
            <Border Grid.Row="4" Grid.ColumnSpan="4"
                    Background="{StaticResource PeggySoftSurfaceBrush}"
                    CornerRadius="8" Padding="10,8">
              <TextBlock
                  Text="Raw microphone audio stays in the isolated local speech process. Ending the conversation unloads every model."
                  Style="{StaticResource SettingsHintStyle}"/>
            </Border>
          </Grid>
        </GroupBox>

        <GroupBox Header="Monitoring behavior"
                  Margin="0,0,0,16">
          <StackPanel>
            <CheckBox x:Name="ScheduleEnabledCheck"
                      Content="Let Peggy sleep outside monitoring hours"
                      FontWeight="SemiBold"
                      Margin="0,0,0,12"
                      Checked="ScheduleEnabledCheck_Changed"
                      Unchecked="ScheduleEnabledCheck_Changed"/>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="96"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="96"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="Wake" VerticalAlignment="Center"
                         Style="{StaticResource SettingsLabelStyle}"
                         Margin="0,0,8,0"/>
              <TextBox x:Name="WakeTimeText" Grid.Column="1"
                       AutomationProperties.Name="Monitoring wake time"
                       MaxLength="5"/>
              <TextBlock Grid.Column="2" Text="Sleep"
                         VerticalAlignment="Center"
                         Style="{StaticResource SettingsLabelStyle}"
                         Margin="18,0,8,0"/>
              <TextBox x:Name="SleepTimeText" Grid.Column="3"
                       AutomationProperties.Name="Monitoring sleep time"
                       MaxLength="5"/>
            </Grid>
            <TextBlock
                Text="Use local 24-hour time (HH:mm). Check now and Talk remain available while sleeping."
                Style="{StaticResource SettingsHintStyle}"
                Margin="0,7,0,14"/>
            <Separator Margin="0,0,0,12"/>
            <CheckBox x:Name="StartupCheck"
                      Content="Start Peggy at Windows sign-in"
                      Margin="0,0,0,9"/>
            <CheckBox x:Name="PausedCheck"
                      Content="Pause monitoring"/>
          </StackPanel>
        </GroupBox>

        <GroupBox Header="Microsoft Teams monitoring">
          <StackPanel>
            <TextBlock Text="Monitoring scope"
                       Style="{StaticResource SettingsLabelStyle}"/>
            <ComboBox x:Name="TeamsScopeCombo"
                      Margin="0,6,0,7"
                      AutomationProperties.Name="Teams monitoring scope"
                      SelectionChanged="TeamsScope_Changed">
              <ComboBoxItem Content="All Teams activity"
                            Tag="AllActivity"/>
              <ComboBoxItem Content="Selected teams and channels only"
                            Tag="SelectedTeamsAndChannels"/>
              <ComboBoxItem Content="Off"
                            Tag="Off"/>
            </ComboBox>
            <TextBlock x:Name="TeamsScopeDescription"
                       Style="{StaticResource SettingsHintStyle}"
                       Margin="0,0,0,10"/>
            <CheckBox x:Name="MonitorTeamsChatsCheck"
                      Content="Also monitor direct and group chats in selected-only mode"
                      Checked="TeamsScope_Changed"
                      Unchecked="TeamsScope_Changed"
                      Margin="0,0,0,10"/>
            <Border x:Name="TeamsScopeWarning"
                    Background="{StaticResource PeggyWarningSurfaceBrush}"
                    BorderBrush="#E7CE79"
                    BorderThickness="1"
                    CornerRadius="9"
                    Padding="10"
                    Margin="0,0,0,12"
                    Visibility="Collapsed">
              <TextBlock x:Name="TeamsScopeWarningText"
                         TextWrapping="Wrap"
                         Foreground="{StaticResource PeggyWarningBrush}"
                         FontSize="11"/>
            </Border>
            <Separator Margin="0,0,0,12"/>
            <StackPanel x:Name="TeamsSelectionPanel">
              <TextBlock x:Name="ChannelStatus"
                         Text="Loading joined Teams..."
                         Style="{StaticResource SettingsHintStyle}"
                         Margin="0,0,0,12"/>
              <TextBlock x:Name="SelectedChannelStatus"
                         Text="Selected Teams sources"
                         Style="{StaticResource SettingsLabelStyle}"
                         Margin="0,0,0,6"/>
              <StackPanel x:Name="SelectedChannelsPanel"
                          Margin="0,0,0,13"/>
              <TextBlock Text="Joined teams"
                         Style="{StaticResource SettingsLabelStyle}"
                         Margin="0,0,0,6"/>
              <Border Background="{StaticResource PeggySoftSurfaceBrush}"
                      BorderBrush="{StaticResource PeggyBorderBrush}"
                      BorderThickness="1"
                      CornerRadius="9"
                      Padding="10">
                <ScrollViewer MaxHeight="320"
                              VerticalScrollBarVisibility="Auto">
                  <StackPanel x:Name="TeamsPanel"/>
                </ScrollViewer>
              </Border>
            </StackPanel>
          </StackPanel>
        </GroupBox>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2"
            Background="{StaticResource PeggySurfaceBrush}"
            BorderBrush="{StaticResource PeggyBorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="18,13">
      <StackPanel Orientation="Horizontal"
                  HorizontalAlignment="Right">
        <Button Content="Cancel" Width="96"
                Margin="0,0,9,0" Click="Cancel_Click"/>
        <Button Content="Save" Width="96"
                Style="{StaticResource PeggyPrimaryButtonStyle}"
                IsDefault="True" Click="Save_Click"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
