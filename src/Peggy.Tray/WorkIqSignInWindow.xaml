<Window x:Class="Peggy.Tray.WorkIqSignInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Peggy.Tray"
        Title="Connect Microsoft 365"
        Width="640" Height="600"
        MinWidth="560" MinHeight="540"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PeggyPageBrush}"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="PeggyTheme.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <Grid Background="{StaticResource PeggyPageBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{StaticResource PeggyHeaderBrush}"
            Padding="24,20">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Width="48" Height="48" CornerRadius="24"
                Background="#F4864F" Margin="0,0,13,0">
          <local:DecorativeTextBlock
              Text="P" Foreground="#513B32"
              FontSize="22" FontWeight="Bold"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"/>
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="Connect Microsoft 365"
                     FontSize="23" FontWeight="SemiBold"
                     Foreground="White"/>
          <TextBlock
              Text="Secure, direct access through standalone Microsoft WorkIQ"
              TextWrapping="Wrap"
              Foreground="#EADFD8"
              FontSize="12" Margin="0,3,0,0"/>
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="24,18,24,22">
        <GroupBox Header="1. Check WorkIQ" Margin="0,0,0,16">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
              <TextBlock Text="Standalone WorkIQ"
                         FontWeight="SemiBold"
                         Foreground="{StaticResource PeggyTextBrush}"/>
              <TextBlock x:Name="InstallationStatus"
                         Text="Checking installation..."
                         TextWrapping="Wrap"
                         Foreground="{StaticResource PeggyMutedTextBrush}"
                         FontSize="11" Margin="0,4,16,0"/>
            </StackPanel>
            <Button x:Name="InstallButton" Grid.Column="1"
                    Content="Install WorkIQ with npm"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Click="Install_Click"/>
          </Grid>
        </GroupBox>

        <GroupBox Header="2. Verify account" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="Microsoft 365 account"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource PeggyTextBrush}"/>
            <TextBox x:Name="AccountText" Margin="0,6,0,9"
                     AutomationProperties.Name="Microsoft 365 account"
                     TextChanged="AccountText_Changed"/>
            <TextBlock
                Text="A browser opens for sign-in and permission consent. Peggy verifies the selected identity before saving it. Edit the address to use a different account."
                TextWrapping="Wrap"
                Foreground="{StaticResource PeggyMutedTextBrush}"
                FontSize="11"/>
            <TextBlock x:Name="AccountChangeNotice"
                       Margin="0,8,0,0"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource PeggyWarningBrush}"
                       FontSize="11"
                       Visibility="Collapsed"/>
          </StackPanel>
        </GroupBox>

        <GroupBox Header="3. Review terms" Margin="0,0,0,16">
          <StackPanel>
            <TextBlock
                Text="Review the current WorkIQ terms before connecting. Peggy binds your acceptance to the exact installed WorkIQ build."
                TextWrapping="Wrap"
                Foreground="{StaticResource PeggyMutedTextBrush}"
                FontSize="11" Margin="0,0,0,11"/>
            <WrapPanel>
              <Button Content="Review WorkIQ EULA"
                      Margin="0,0,12,8"
                      Click="ReviewEula_Click"/>
              <CheckBox x:Name="EulaCheck"
                        Content="I reviewed and accept the WorkIQ EULA"
                        VerticalAlignment="Center"
                        Margin="0,0,0,8"/>
            </WrapPanel>
          </StackPanel>
        </GroupBox>

        <Border Background="{StaticResource PeggyWarningSurfaceBrush}"
                BorderBrush="#E7CE79"
                BorderThickness="1"
                CornerRadius="10"
                Padding="11">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Width="30" Height="30" CornerRadius="15"
                    Background="#F8D76E" Margin="0,0,10,0">
              <local:DecorativeTextBlock
                  Text="i" FontWeight="Bold"
                  Foreground="{StaticResource PeggyWarningBrush}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"/>
            </Border>
            <TextBlock x:Name="OperationStatus" Grid.Column="1"
                       Text="Ready to connect."
                       TextWrapping="Wrap"
                       Foreground="{StaticResource PeggyWarningBrush}"
                       VerticalAlignment="Center"/>
          </Grid>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2"
            Background="{StaticResource PeggySurfaceBrush}"
            BorderBrush="{StaticResource PeggyBorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="18,13">
      <StackPanel Orientation="Horizontal"
                  HorizontalAlignment="Right">
        <Button x:Name="CancelButton"
                Content="Cancel" Width="105"
                Margin="0,0,9,0"
                Click="Cancel_Click"/>
        <Button x:Name="SignInButton"
                Content="Sign in" Width="125"
                Style="{StaticResource PeggyPrimaryButtonStyle}"
                IsDefault="True"
                Click="SignIn_Click"/>
      </StackPanel>
    </Border>
  </Grid>
</Window>
