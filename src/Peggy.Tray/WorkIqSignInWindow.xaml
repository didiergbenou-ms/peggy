<Window x:Class="Peggy.Tray.WorkIqSignInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Connect Microsoft 365"
        Width="620" Height="560"
        MinWidth="560" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="#f4f1ec">
  <Grid Margin="24">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0">
      <TextBlock Text="Connect Microsoft 365"
                 FontSize="26"
                 FontWeight="SemiBold"
                 Foreground="#513b32"/>
      <TextBlock
          Text="Peggy connects directly through the standalone Microsoft WorkIQ CLI."
          TextWrapping="Wrap"
          Foreground="#6f625b"
          Margin="0,5,0,18"/>
    </StackPanel>

    <StackPanel Grid.Row="1">
      <Border Background="White"
              BorderBrush="#e6ddd5"
              BorderThickness="1"
              CornerRadius="12"
              Padding="14"
              Margin="0,0,0,16">
        <StackPanel>
          <TextBlock Text="Standalone WorkIQ"
                     FontWeight="SemiBold"/>
          <TextBlock x:Name="InstallationStatus"
                     Text="Checking installation..."
                     TextWrapping="Wrap"
                     Foreground="#6f625b"
                     Margin="0,4,0,10"/>
          <Button x:Name="InstallButton"
                  Content="Install WorkIQ with npm"
                  Width="190"
                  HorizontalAlignment="Left"
                  Padding="10,6"
                  Click="Install_Click"/>
        </StackPanel>
      </Border>

      <TextBlock Text="Microsoft 365 account"
                 FontWeight="SemiBold"/>
      <TextBox x:Name="AccountText"
               Padding="9"
               Margin="0,5,0,14"/>

      <TextBlock
          Text="A browser window opens for Microsoft sign-in and permission consent. Peggy verifies the selected account before saving it."
          TextWrapping="Wrap"
          Foreground="#6f625b"
          Margin="0,0,0,14"/>

      <StackPanel Orientation="Horizontal"
                  Margin="0,0,0,10">
        <Button Content="Review WorkIQ EULA"
                Width="170"
                Padding="10,6"
                Margin="0,0,10,0"
                Click="ReviewEula_Click"/>
        <CheckBox x:Name="EulaCheck"
                  Content="I reviewed and accept the WorkIQ EULA."
                  VerticalAlignment="Center"/>
      </StackPanel>

      <Border Background="#fff4ce"
              BorderBrush="#f7a54a"
              BorderThickness="1"
              CornerRadius="9"
              Padding="10">
        <TextBlock x:Name="OperationStatus"
                   Text="Ready to connect."
                   TextWrapping="Wrap"
                   Foreground="#513b32"/>
      </Border>
    </StackPanel>

    <StackPanel Grid.Row="2"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="0,18,0,0">
      <Button x:Name="CancelButton"
              Content="Cancel"
              Width="100"
              Padding="10,7"
              Margin="0,0,10,0"
              Click="Cancel_Click"/>
      <Button x:Name="SignInButton"
              Content="Sign in"
              Width="120"
              Padding="10,7"
              IsDefault="True"
              Click="SignIn_Click"/>
    </StackPanel>
  </Grid>
</Window>
