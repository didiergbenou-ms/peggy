<Window x:Class="Peggy.Tray.ConversationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Peggy.Tray"
        Title="Talk to Peggy" Width="600" Height="720"
        MinWidth="500" MinHeight="540"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PeggyPageBrush}"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="PeggyTheme.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <Grid Background="{StaticResource PeggyPageBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{StaticResource PeggyHeaderBrush}"
            Padding="22,18">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border Width="44" Height="44" CornerRadius="22"
                Background="#F4864F" Margin="0,0,12,0">
          <local:DecorativeTextBlock
              Text="P" Foreground="#513B32"
              FontSize="20" FontWeight="Bold"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"/>
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock x:Name="ConversationTitleText"
                     Text="Talk to Peggy"
                     Foreground="White"
                     FontSize="22" FontWeight="SemiBold"/>
          <Border Background="#1FFFFFFF" CornerRadius="9"
                  HorizontalAlignment="Left" Padding="8,3"
                  Margin="0,5,0,0">
            <TextBlock x:Name="StatusText" Text="Ready"
                       Foreground="White" FontSize="11"
                       FontWeight="SemiBold"/>
          </Border>
        </StackPanel>
        <Button Grid.Column="2" Content="End conversation"
                Style="{StaticResource PeggyHeaderButtonStyle}"
                Margin="14,0,0,0"
                VerticalAlignment="Top"
                Click="End_Click"/>
      </Grid>
    </Border>

    <Border x:Name="CriticalBanner" Grid.Row="1"
            Visibility="Collapsed"
            Background="{StaticResource PeggyCriticalSurfaceBrush}"
            BorderBrush="#E3A39D"
            BorderThickness="1"
            CornerRadius="11"
            Padding="12"
            Margin="18,14,18,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border Width="30" Height="30" CornerRadius="15"
                Background="#B42318" Margin="0,0,10,0">
          <local:DecorativeTextBlock
              Text="!" Foreground="White"
              FontWeight="Bold" FontSize="16"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"/>
        </Border>
        <TextBlock x:Name="CriticalText" Grid.Column="1"
                   TextWrapping="Wrap"
                   Foreground="{StaticResource PeggyCriticalBrush}"
                   FontWeight="SemiBold"
                   VerticalAlignment="Center"
                   Margin="0,0,12,0"/>
        <Button Grid.Column="2" Content="Switch"
                Style="{StaticResource PeggyCriticalButtonStyle}"
                Click="SwitchCritical_Click"/>
      </Grid>
    </Border>

    <ScrollViewer x:Name="TranscriptScroll" Grid.Row="2"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  PanningMode="VerticalOnly">
      <StackPanel>
        <StackPanel x:Name="TranscriptPanel"
                    Margin="18,16,18,12"/>

        <Border x:Name="TranscriptReviewCard"
                Visibility="Collapsed"
                Background="{StaticResource PeggySurfaceBrush}"
                BorderBrush="#8BB4CF" BorderThickness="1"
                CornerRadius="12" Padding="15"
                Margin="18,0,18,12"
                Effect="{StaticResource PeggyCardShadow}">
          <StackPanel>
            <DockPanel>
              <Border Width="30" Height="30" CornerRadius="15"
                      Background="#EAF2F8" Margin="0,0,10,0">
                <local:DecorativeTextBlock
                    Text="&#xE720;"
                    FontFamily="Segoe MDL2 Assets"
                    Foreground="#2D688E" FontSize="14"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>
              </Border>
              <StackPanel>
                <TextBlock Text="I heard..." Foreground="#2D688E"
                           FontWeight="SemiBold" FontSize="14"/>
                <TextBlock
                    Text="Edit anything that is wrong before it leaves the local speech process."
                    TextWrapping="Wrap"
                    Foreground="{StaticResource PeggyMutedTextBrush}"
                    FontSize="11" Margin="0,2,0,0"/>
              </StackPanel>
            </DockPanel>
            <TextBlock x:Name="TranscriptReviewCountdown"
                       TextWrapping="Wrap" Foreground="#2D688E"
                       FontWeight="SemiBold" FontSize="11"
                       Margin="0,10,0,7"/>
            <TextBox x:Name="TranscriptReviewText"
                     TextWrapping="Wrap" AcceptsReturn="True"
                     AutomationProperties.Name="Transcript review"
                     MaxHeight="120"
                     VerticalScrollBarVisibility="Auto"
                     Margin="0,0,0,10"
                     TextChanged="TranscriptReviewText_TextChanged"/>
            <WrapPanel>
              <Button x:Name="UseTranscriptButton"
                      Content="Send now"
                      Style="{StaticResource PeggyPrimaryButtonStyle}"
                      Margin="0,0,8,7"
                      Click="UseTranscript_Click"/>
              <Button x:Name="CancelTranscriptButton"
                      Content="Cancel auto-send"
                      Margin="0,0,8,7"
                      Click="CancelTranscript_Click"/>
              <Button Content="Try again"
                      Margin="0,0,8,7"
                      Click="RetryTranscript_Click"/>
            </WrapPanel>
          </StackPanel>
        </Border>

        <Border x:Name="ActionCard"
                Visibility="Collapsed"
                Background="{StaticResource PeggySurfaceBrush}"
                BorderBrush="#D59A52" BorderThickness="1"
                CornerRadius="12" Padding="15"
                Margin="18,0,18,12"
                Effect="{StaticResource PeggyCardShadow}">
          <StackPanel>
            <DockPanel>
              <Border Width="30" Height="30" CornerRadius="15"
                      Background="#FFF1DD" Margin="0,0,10,0">
                <local:DecorativeTextBlock
                    Text="!" Foreground="#9A5514"
                    FontWeight="Bold" FontSize="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"/>
              </Border>
              <StackPanel>
                <TextBlock Text="Action approval"
                           Foreground="#8C4A0C"
                           FontWeight="SemiBold" FontSize="14"/>
                <TextBlock Text="Review exactly what Peggy will do."
                           Foreground="{StaticResource PeggyMutedTextBrush}"
                           FontSize="11" Margin="0,2,0,0"/>
              </StackPanel>
            </DockPanel>
            <ScrollViewer MaxHeight="220"
                          Margin="0,10,0,11"
                          VerticalScrollBarVisibility="Auto">
              <Border Background="{StaticResource PeggySoftSurfaceBrush}"
                      CornerRadius="8" Padding="10">
                <TextBlock x:Name="ActionDescription"
                           TextWrapping="Wrap" FontSize="13"
                           Foreground="{StaticResource PeggyTextBrush}"/>
              </Border>
            </ScrollViewer>
            <WrapPanel x:Name="NormalApprovalPanel">
              <Button Content="Approve"
                      Style="{StaticResource PeggyPositiveButtonStyle}"
                      Margin="0,0,8,7"
                      Click="Approve_Click"/>
              <Button Content="Cancel"
                      Margin="0,0,8,7"
                      Click="CancelAction_Click"/>
            </WrapPanel>
            <StackPanel x:Name="TypedApprovalPanel"
                        Visibility="Collapsed">
              <TextBlock x:Name="TypedInstruction"
                         TextWrapping="Wrap"
                         Foreground="{StaticResource PeggyCriticalBrush}"
                         Margin="0,0,0,8"/>
              <TextBox x:Name="TypedConfirmation"
                       AutomationProperties.Name="Typed destructive action confirmation"
                       Margin="0,0,0,9"/>
              <WrapPanel>
                <Button Content="Confirm destructive action"
                        Style="{StaticResource PeggyCriticalButtonStyle}"
                        Margin="0,0,8,7"
                        Click="TypedConfirm_Click"/>
                <Button Content="Cancel"
                        Margin="0,0,8,7"
                        Click="CancelAction_Click"/>
              </WrapPanel>
            </StackPanel>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="3"
            Background="{StaticResource PeggySurfaceBrush}"
            BorderBrush="{StaticResource PeggyBorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="16,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Local voice"
                     FontWeight="SemiBold" FontSize="12"
                     Foreground="{StaticResource PeggyTextBrush}"/>
          <TextBlock x:Name="VoiceHintText"
                     Text="Tap while Peggy speaks to interrupt."
                     Foreground="{StaticResource PeggyMutedTextBrush}"
                     FontSize="11" Margin="0,2,14,0"/>
        </StackPanel>
        <Button x:Name="MicrophoneButton" Grid.Column="1"
                Content="Listen" MinWidth="112"
                Style="{StaticResource PeggyPrimaryButtonStyle}"
                Click="Microphone_Click"/>
      </Grid>
    </Border>
  </Grid>
</Window>
