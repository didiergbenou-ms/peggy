<Window x:Class="Peggy.Tray.ConversationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Talk to Peggy" Width="560" Height="680"
        MinWidth="480" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        Background="#f4f1ec" ShowInTaskbar="False">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#513b32" Padding="18,14">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="End conversation"
                Padding="12,6" Click="End_Click"/>
        <StackPanel>
          <TextBlock x:Name="ConversationTitleText" Text="Talk to Peggy"
                     Foreground="White"
                     FontSize="21" FontWeight="SemiBold"/>
          <TextBlock x:Name="StatusText" Text="Ready"
                     Foreground="#eadfd8" FontSize="12" Margin="0,3,0,0"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Border x:Name="CriticalBanner" Grid.Row="1" Visibility="Collapsed"
            Background="#fde4e2" BorderBrush="#b42318" BorderThickness="0,0,0,1"
            Padding="12,9">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Switch" Padding="10,4"
                Click="SwitchCritical_Click"/>
        <TextBlock x:Name="CriticalText" TextWrapping="Wrap"
                   Foreground="#8b1a12" FontWeight="SemiBold"/>
      </DockPanel>
    </Border>

    <ScrollViewer x:Name="TranscriptScroll" Grid.Row="2"
                  VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="TranscriptPanel" Margin="16"/>
    </ScrollViewer>

    <Border x:Name="TranscriptReviewCard" Grid.Row="3"
            Visibility="Collapsed" Background="White"
            BorderBrush="#2d688e" BorderThickness="2"
            CornerRadius="10" Padding="14" Margin="16,0,16,12">
      <StackPanel>
        <TextBlock Text="I heard..." Foreground="#2d688e"
                  FontWeight="SemiBold" FontSize="14"/>
        <TextBlock Text="Edit anything that is wrong before it leaves the local speech process."
                  TextWrapping="Wrap" Foreground="#62564f"
                  FontSize="11" Margin="0,3,0,8"/>
        <TextBlock x:Name="TranscriptReviewCountdown"
                  TextWrapping="Wrap" Foreground="#2d688e"
                  FontWeight="SemiBold" FontSize="11"
                  Margin="0,0,0,7"/>
        <TextBox x:Name="TranscriptReviewText" Padding="8"
                TextWrapping="Wrap" AcceptsReturn="True"
                MaxHeight="120" VerticalScrollBarVisibility="Auto"
                Margin="0,0,0,9"
                TextChanged="TranscriptReviewText_TextChanged"/>
        <StackPanel Orientation="Horizontal">
          <Button x:Name="UseTranscriptButton" Content="Send now"
                 Padding="14,6" Margin="0,0,8,0"
                 Click="UseTranscript_Click"/>
          <Button x:Name="CancelTranscriptButton"
                 Content="Cancel auto-send" Padding="14,6"
                 Margin="0,0,8,0" Click="CancelTranscript_Click"/>
          <Button Content="Try again" Padding="14,6"
                 Click="RetryTranscript_Click"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <Border x:Name="ActionCard" Grid.Row="4" Visibility="Collapsed"
            Background="White" BorderBrush="#c66b11" BorderThickness="2"
            CornerRadius="10" Padding="14" Margin="16,0,16,12">
      <StackPanel>
        <TextBlock Text="Action approval" Foreground="#9b5108"
                   FontWeight="SemiBold" FontSize="14"/>
        <ScrollViewer MaxHeight="220" Margin="0,7,0,10"
                      VerticalScrollBarVisibility="Auto">
          <TextBlock x:Name="ActionDescription" TextWrapping="Wrap"
                     FontSize="13"/>
        </ScrollViewer>
        <StackPanel x:Name="NormalApprovalPanel" Orientation="Horizontal">
          <Button Content="Approve" Padding="14,6" Margin="0,0,8,0"
                  Click="Approve_Click"/>
          <Button Content="Cancel" Padding="14,6" Click="CancelAction_Click"/>
        </StackPanel>
        <StackPanel x:Name="TypedApprovalPanel" Visibility="Collapsed">
          <TextBlock x:Name="TypedInstruction" TextWrapping="Wrap"
                     Foreground="#8b1a12" Margin="0,0,0,7"/>
          <TextBox x:Name="TypedConfirmation" Padding="8" Margin="0,0,0,8"/>
          <StackPanel Orientation="Horizontal">
            <Button Content="Confirm destructive action" Padding="14,6"
                    Margin="0,0,8,0" Click="TypedConfirm_Click"/>
            <Button Content="Cancel" Padding="14,6" Click="CancelAction_Click"/>
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Grid.Row="5" Background="#e9e2dc" Padding="14">
      <DockPanel>
        <Button x:Name="MicrophoneButton" DockPanel.Dock="Right"
                Content="Listen" Width="110" Padding="12,7"
                Click="Microphone_Click"/>
        <TextBlock x:Name="VoiceHintText"
                   Text="Voice only. Tap while Peggy speaks to interrupt."
                   VerticalAlignment="Center" Foreground="#62564f"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
