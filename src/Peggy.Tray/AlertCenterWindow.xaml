<Window x:Class="Peggy.Tray.AlertCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Peggy alerts" Width="520" Height="700"
        MinWidth="440" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        Background="#f4f1ec" ShowInTaskbar="False">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#513b32" Padding="18,14">
      <DockPanel>
        <StackPanel DockPanel.Dock="Left">
          <TextBlock x:Name="AssistantNameText" Text="Peggy"
                     Foreground="White" FontSize="22" FontWeight="SemiBold"/>
          <TextBlock x:Name="StatusText" Text="No active alerts"
                     Foreground="#eadfd8" FontSize="12" Margin="0,3,0,0"/>
        </StackPanel>
        <Button DockPanel.Dock="Right" Content="Hide" Padding="14,6"
                VerticalAlignment="Center" Click="Hide_Click"/>
      </DockPanel>
    </Border>

    <Border x:Name="HealthBanner" Grid.Row="1" Visibility="Collapsed"
            Background="#fff2cc" BorderBrush="#d6a800" BorderThickness="0,0,0,1"
            Padding="14,10">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Retry now" Padding="12,5"
                Click="Retry_Click"/>
        <StackPanel>
          <TextBlock Text="Monitoring interrupted" FontWeight="SemiBold"
                     Foreground="#6b5000"/>
          <TextBlock x:Name="HealthDetail" TextWrapping="Wrap"
                     Foreground="#6b5000" Margin="0,3,10,0"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Border x:Name="CriticalBanner" Grid.Row="2" Visibility="Collapsed"
            Background="#fde4e2" BorderBrush="#b42318" BorderThickness="0,0,0,1"
            Padding="14,10">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Switch to alert" Padding="12,5"
                Click="SwitchCritical_Click"/>
        <StackPanel>
          <TextBlock Text="Critical update" FontWeight="SemiBold"
                     Foreground="#8b1a12"/>
          <TextBlock x:Name="CriticalText" TextWrapping="Wrap"
                     Foreground="#8b1a12" Margin="0,3,10,0"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
      <StackPanel x:Name="CardsPanel" Margin="16"/>
    </ScrollViewer>
  </Grid>
</Window>
