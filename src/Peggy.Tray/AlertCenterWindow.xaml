<Window x:Class="Peggy.Tray.AlertCenterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Peggy.Tray"
        Title="Peggy alerts"
        Width="620"
        Height="780"
        MinWidth="520"
        MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="#F7F3EE"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <SolidColorBrush x:Key="PageBrush" Color="#F7F3EE"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFEFC"/>
    <SolidColorBrush x:Key="TextBrush" Color="#2D2926"/>
    <SolidColorBrush x:Key="MutedTextBrush" Color="#756961"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#E5DBD3"/>
    <SolidColorBrush x:Key="BrandBrush" Color="#B84B30"/>
    <SolidColorBrush x:Key="BrandDarkBrush" Color="#513B32"/>

    <DropShadowEffect x:Key="CardShadow"
                      Color="#452E22"
                      BlurRadius="18"
                      ShadowDepth="3"
                      Opacity="0.12"/>

    <Style x:Key="ButtonBaseStyle" TargetType="Button">
      <Setter Property="FontFamily" Value="Segoe UI"/>
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="MinHeight" Value="34"/>
      <Setter Property="Padding" Value="13,7"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="ButtonBorder"
                      Background="{TemplateBinding Background}"
                      BorderBrush="{TemplateBinding BorderBrush}"
                      BorderThickness="{TemplateBinding BorderThickness}"
                      CornerRadius="8"
                      SnapsToDevicePixels="True"/>
              <Border x:Name="StateOverlay"
                      Background="Transparent"
                      CornerRadius="8"
                      IsHitTestVisible="False"/>
              <ContentPresenter HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Margin="{TemplateBinding Padding}"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="StateOverlay"
                        Property="Background"
                        Value="#08000000"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="StateOverlay"
                        Property="Background"
                        Value="#18000000"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="ButtonBorder"
                        Property="Opacity"
                        Value="0.42"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style x:Key="HeaderButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource ButtonBaseStyle}">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="#1FFFFFFF"/>
      <Setter Property="BorderBrush" Value="#3DFFFFFF"/>
    </Style>

    <Style x:Key="HeaderDangerButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource ButtonBaseStyle}">
      <Setter Property="Foreground" Value="#FFF3EE"/>
      <Setter Property="Background" Value="#18FFFFFF"/>
      <Setter Property="BorderBrush" Value="#5CFFFFFF"/>
    </Style>

    <Style x:Key="PrimaryActionButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource ButtonBaseStyle}">
      <Setter Property="Foreground" Value="White"/>
      <Setter Property="Background" Value="{StaticResource BrandBrush}"/>
      <Setter Property="BorderBrush" Value="{StaticResource BrandBrush}"/>
    </Style>

    <Style x:Key="SecondaryActionButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource ButtonBaseStyle}">
      <Setter Property="Foreground" Value="#8D3F29"/>
      <Setter Property="Background" Value="#FFF0E9"/>
      <Setter Property="BorderBrush" Value="#F1C8B9"/>
    </Style>

    <Style x:Key="PositiveActionButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource ButtonBaseStyle}">
      <Setter Property="Foreground" Value="#275E3A"/>
      <Setter Property="Background" Value="#EDF7F0"/>
      <Setter Property="BorderBrush" Value="#C6E1CE"/>
    </Style>

    <Style x:Key="SubtleActionButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource ButtonBaseStyle}">
      <Setter Property="Foreground" Value="{StaticResource BrandDarkBrush}"/>
      <Setter Property="Background" Value="#FAF7F4"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
    </Style>

    <Style x:Key="TextActionButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource ButtonBaseStyle}">
      <Setter Property="MinHeight" Value="28"/>
      <Setter Property="Padding" Value="7,4"/>
      <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderBrush" Value="Transparent"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="Normal"/>
    </Style>

    <Style x:Key="BannerActionButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource ButtonBaseStyle}">
      <Setter Property="Foreground" Value="#6B5000"/>
      <Setter Property="Background" Value="#FFFFF8"/>
      <Setter Property="BorderBrush" Value="#E5C96F"/>
    </Style>

    <Style x:Key="CriticalActionButtonStyle"
           TargetType="Button"
           BasedOn="{StaticResource ButtonBaseStyle}">
      <Setter Property="Foreground" Value="#8B1A12"/>
      <Setter Property="Background" Value="#FFF9F8"/>
      <Setter Property="BorderBrush" Value="#E7A6A0"/>
    </Style>

    <Style x:Key="PriorityComboStyle" TargetType="ComboBox">
      <Setter Property="MinHeight" Value="32"/>
      <Setter Property="Padding" Value="8,5"/>
      <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
      <Setter Property="Background" Value="White"/>
      <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="FontSize" Value="12"/>
    </Style>
  </Window.Resources>

  <Grid Background="{StaticResource PageBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Padding="24,20,22,18">
      <Border.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
          <GradientStop Color="#513B32" Offset="0"/>
          <GradientStop Color="#704B38" Offset="0.62"/>
          <GradientStop Color="#8D5438" Offset="1"/>
        </LinearGradientBrush>
      </Border.Background>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border Width="48"
                Height="48"
                CornerRadius="24"
                Background="#F4864F"
                Margin="0,0,13,0"
                VerticalAlignment="Top">
          <local:DecorativeTextBlock
              Text="P"
              Foreground="#513B32"
              FontSize="22"
              FontWeight="Bold"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"/>
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <WrapPanel>
            <TextBlock x:Name="AssistantNameText"
                       Text="Peggy"
                       Foreground="White"
                       FontSize="23"
                       FontWeight="SemiBold"
                       Margin="0,0,10,0"/>
            <TextBlock x:Name="VersionText"
                       Foreground="#EADFD8"
                       FontSize="11"
                       VerticalAlignment="Center"
                       ToolTip="Peggy release version"
                       AutomationProperties.Name="Peggy release version"/>
          </WrapPanel>
          <TextBlock Text="Your work, sorted by what matters"
                     Foreground="#EADFD8"
                     FontSize="12"
                     Margin="0,2,0,8"/>
          <Border Background="#1FFFFFFF"
                  CornerRadius="10"
                  HorizontalAlignment="Left"
                  Padding="9,4">
            <TextBlock x:Name="StatusText"
                       Text="No active alerts"
                       Foreground="White"
                       FontSize="11"
                       FontWeight="SemiBold"/>
          </Border>
        </StackPanel>
        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    VerticalAlignment="Top"
                    Margin="16,0,0,0">
          <Button x:Name="DismissAllButton"
                  Content="Dismiss all"
                  Style="{StaticResource HeaderDangerButtonStyle}"
                  Margin="0,0,8,0"
                  IsEnabled="False"
                  ToolTip="Dismiss every active alert"
                  Click="DismissAll_Click"/>
          <Button Content="Hide"
                  Style="{StaticResource HeaderButtonStyle}"
                  Click="Hide_Click"/>
        </StackPanel>
      </Grid>
    </Border>

    <Border x:Name="HealthBanner"
            Grid.Row="1"
            Visibility="Collapsed"
            Background="#FFF8DE"
            BorderBrush="#E7CE79"
            BorderThickness="1"
            CornerRadius="12"
            Padding="14"
            Margin="22,16,22,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border Width="34"
                Height="34"
                CornerRadius="17"
                Background="#F8D76E"
                Margin="0,0,11,0"
                VerticalAlignment="Top">
          <local:DecorativeTextBlock
              Text="!"
              FontSize="18"
              FontWeight="Bold"
              Foreground="#6B5000"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"/>
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock x:Name="HealthTitle"
                     Text="Monitoring interrupted"
                     FontWeight="SemiBold"
                     FontSize="13"
                     Foreground="#604700"/>
          <TextBlock x:Name="HealthDetail"
                     TextWrapping="Wrap"
                     Foreground="#735B19"
                     FontSize="12"
                     Margin="0,3,14,0"/>
        </StackPanel>
        <StackPanel Grid.Column="2"
                    Orientation="Horizontal"
                    VerticalAlignment="Center">
          <Button Content="Troubleshoot"
                  Style="{StaticResource BannerActionButtonStyle}"
                  Margin="0,0,8,0"
                  Click="Troubleshoot_Click"/>
          <Button Content="Retry now"
                  Style="{StaticResource BannerActionButtonStyle}"
                  Click="Retry_Click"/>
        </StackPanel>
      </Grid>
    </Border>

    <Border x:Name="CriticalBanner"
            Grid.Row="2"
            Visibility="Collapsed"
            Background="#FDECEA"
            BorderBrush="#E3A39D"
            BorderThickness="1"
            CornerRadius="12"
            Padding="14"
            Margin="22,12,22,0">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border Width="34"
                Height="34"
                CornerRadius="17"
                Background="#B42318"
                Margin="0,0,11,0"
                VerticalAlignment="Top">
          <local:DecorativeTextBlock
              Text="!"
              FontSize="18"
              FontWeight="Bold"
              Foreground="White"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"/>
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="Critical update"
                     FontWeight="SemiBold"
                     FontSize="13"
                     Foreground="#8B1A12"/>
          <TextBlock x:Name="CriticalText"
                     TextWrapping="Wrap"
                     Foreground="#8B322B"
                     FontSize="12"
                     Margin="0,3,14,0"/>
        </StackPanel>
        <Button Grid.Column="2"
                Content="Switch to alert"
                Style="{StaticResource CriticalActionButtonStyle}"
                VerticalAlignment="Center"
                Click="SwitchCritical_Click"/>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="3"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  PanningMode="VerticalOnly">
      <StackPanel Margin="22,18,22,24">
        <Grid Margin="2,0,2,12">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Grid.Column="0"
                     Text="Your alerts"
                     FontSize="17"
                     FontWeight="SemiBold"
                     Foreground="{StaticResource TextBrush}"/>
          <TextBlock x:Name="ListCaptionText"
                     Grid.Column="1"
                     Text="Prioritized by Peggy"
                     FontSize="11"
                     Foreground="{StaticResource MutedTextBrush}"
                     VerticalAlignment="Center"
                     Margin="16,0,0,0"/>
        </Grid>
        <StackPanel x:Name="CardsPanel"/>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Window>
