<Window x:Class="Peggy.Tray.TroubleshootingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Peggy.Tray"
        Title="Peggy troubleshooting"
        Width="720"
        Height="760"
        MinWidth="620"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource PeggyPageBrush}"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="PeggyTheme.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0"
            Background="{StaticResource PeggyHeaderBrush}"
            Padding="24,19">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Border Width="46"
                Height="46"
                CornerRadius="23"
                Background="#F8D76E"
                Margin="0,0,13,0">
          <local:DecorativeTextBlock
              Text="!"
              Foreground="#513B32"
              FontSize="22"
              FontWeight="Bold"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"/>
        </Border>
        <StackPanel Grid.Column="1"
                    VerticalAlignment="Center">
          <TextBlock Text="Troubleshoot monitoring"
                     Foreground="White"
                     FontSize="23"
                     FontWeight="SemiBold"/>
          <TextBlock
              Text="Read-only checks diagnose the failure without changing Peggy state"
              Foreground="#EADFD8"
              FontSize="12"
              Margin="0,3,0,0"/>
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="24,18,24,24">
        <GroupBox Header="Original failure"
                  Margin="0,0,0,16">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock Text="Time"
                       FontWeight="SemiBold"
                       Margin="0,0,14,5"/>
            <TextBlock x:Name="FailureTimeText"
                       Grid.Column="1"
                       Margin="0,0,0,5"/>
            <TextBlock Grid.Row="1"
                       Text="Stage"
                       FontWeight="SemiBold"
                       Margin="0,0,14,5"/>
            <TextBlock x:Name="FailureStageText"
                       Grid.Row="1"
                       Grid.Column="1"
                       Margin="0,0,0,5"/>
            <TextBlock Grid.Row="2"
                       Text="Code"
                       FontWeight="SemiBold"
                       Margin="0,0,14,5"/>
            <TextBlock x:Name="FailureCodeText"
                       Grid.Row="2"
                       Grid.Column="1"
                       Margin="0,0,0,5"/>
            <TextBlock Grid.Row="3"
                       Text="Status"
                       FontWeight="SemiBold"
                       Margin="0,0,14,5"/>
            <TextBlock x:Name="FailureStatusText"
                       Grid.Row="3"
                       Grid.Column="1"
                       Margin="0,0,0,5"/>
            <TextBlock Grid.Row="4"
                       Text="Message"
                       FontWeight="SemiBold"
                       Margin="0,0,14,0"
                       VerticalAlignment="Top"/>
            <TextBlock x:Name="FailureMessageText"
                       Grid.Row="4"
                       Grid.Column="1"
                       TextWrapping="Wrap"/>
          </Grid>
        </GroupBox>

        <GroupBox Header="Read-only checks"
                  Margin="0,0,0,16">
          <StackPanel>
            <TextBlock x:Name="RunStatusText"
                       Text="Ready to run checks."
                       Foreground="{StaticResource PeggyMutedTextBrush}"
                       FontSize="11"
                       Margin="0,0,0,10"
                       AutomationProperties.LiveSetting="Polite"/>
            <StackPanel x:Name="ChecksPanel"/>
          </StackPanel>
        </GroupBox>

        <Border x:Name="RecommendationBorder"
                Background="{StaticResource PeggyWarningSurfaceBrush}"
                BorderBrush="#E7CE79"
                BorderThickness="1"
                CornerRadius="10"
                Padding="13"
                Margin="0,0,0,16">
          <StackPanel>
            <TextBlock Text="Recommendation"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource PeggyWarningBrush}"/>
            <TextBlock x:Name="RecommendationText"
                       Text="Run the checks to get a targeted recommendation."
                       TextWrapping="Wrap"
                       Foreground="{StaticResource PeggyWarningBrush}"
                       Margin="0,4,0,0"/>
          </StackPanel>
        </Border>

        <StackPanel x:Name="RecommendedActionsPanel"
                    Orientation="Horizontal">
          <Button x:Name="SignInButton"
                  Content="Sign in again"
                  Style="{StaticResource PeggyPrimaryButtonStyle}"
                  Margin="0,0,8,0"
                  Visibility="Collapsed"
                  Click="SignIn_Click"/>
          <Button x:Name="SettingsButton"
                  Content="Open Settings"
                  Style="{StaticResource PeggyPrimaryButtonStyle}"
                  Margin="0,0,8,0"
                  Visibility="Collapsed"
                  Click="Settings_Click"/>
          <Button x:Name="RetryMonitoringButton"
                  Content="Retry monitoring"
                  Style="{StaticResource PeggyPrimaryButtonStyle}"
                  Visibility="Collapsed"
                  Click="RetryMonitoring_Click"/>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2"
            Background="{StaticResource PeggySurfaceBrush}"
            BorderBrush="{StaticResource PeggyBorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="18,13">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Horizontal">
          <Button x:Name="RunAgainButton"
                  Content="Run checks"
                  Style="{StaticResource PeggySecondaryButtonStyle}"
                  Margin="0,0,8,0"
                  Click="RunAgain_Click"/>
          <Button x:Name="CopyDetailsButton"
                  Content="Copy technical details"
                  Style="{StaticResource PeggySecondaryButtonStyle}"
                  Margin="0,0,8,0"
                  IsEnabled="False"
                  Click="CopyDetails_Click"/>
          <Button x:Name="CreateZipButton"
                  Content="Create diagnostic ZIP"
                  Style="{StaticResource PeggySecondaryButtonStyle}"
                  Click="CreateZip_Click"/>
        </StackPanel>
        <Button Grid.Column="1"
                Content="Close"
                Width="92"
                IsCancel="True"
                Click="Close_Click"/>
      </Grid>
    </Border>
  </Grid>
</Window>
