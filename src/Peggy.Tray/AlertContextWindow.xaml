<Window x:Class="Peggy.Tray.AlertContextWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Peggy.Tray"
        Title="Peggy alert context" Width="700" Height="740"
        MinWidth="540" MinHeight="540"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PeggyPageBrush}"
        ShowInTaskbar="False"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="PeggyTheme.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <Grid Background="{StaticResource PeggyPageBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="{StaticResource PeggyHeaderBrush}"
            Padding="22,18">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Border Width="44" Height="44" CornerRadius="22"
                Background="#F4864F" Margin="0,0,12,0">
          <local:DecorativeTextBlock
              Text="P" Foreground="#513B32"
              FontSize="20" FontWeight="Bold"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"/>
        </Border>
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock x:Name="TitleText" Text="Alert context"
                     Foreground="White" FontSize="21"
                     FontWeight="SemiBold"
                     TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="MetaText" Foreground="#EADFD8"
                     FontSize="12" Margin="0,3,0,0"/>
        </StackPanel>
        <Button Grid.Column="2" Content="Close"
                Style="{StaticResource PeggyHeaderButtonStyle}"
                Margin="14,0,0,0"
                VerticalAlignment="Top"
                Click="Close_Click"/>
      </Grid>
    </Border>

    <ScrollViewer Grid.Row="1"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  PanningMode="VerticalOnly">
      <StackPanel Margin="22,18,22,24">
        <TextBlock x:Name="ReasonHeading"
                   Text="Why Peggy alerted you"
                   FontSize="16" FontWeight="SemiBold"
                   Foreground="{StaticResource PeggyTextBrush}"
                   Margin="2,0,0,10"/>
        <Border Background="{StaticResource PeggySurfaceBrush}"
                BorderBrush="{StaticResource PeggyBorderBrush}"
                BorderThickness="1" CornerRadius="13"
                Padding="16" Margin="0,0,0,20"
                Effect="{StaticResource PeggyCardShadow}">
          <StackPanel>
            <Border Background="{StaticResource PeggyBrandSoftBrush}"
                    CornerRadius="8" HorizontalAlignment="Left"
                    Padding="8,4" Margin="0,0,0,10">
              <TextBlock Text="Saved alert"
                         Foreground="#8D3F29"
                         FontSize="10" FontWeight="SemiBold"/>
            </Border>
            <TextBlock x:Name="SummaryText" TextWrapping="Wrap"
                       FontSize="16" FontWeight="SemiBold"
                       LineHeight="22"
                       Foreground="{StaticResource PeggyTextBrush}"/>
            <TextBlock x:Name="ReasonText" TextWrapping="Wrap"
                       FontSize="12" LineHeight="18"
                       Foreground="{StaticResource PeggyMutedTextBrush}"
                       Margin="0,8,0,0"/>
          </StackPanel>
        </Border>

        <Grid Margin="2,0,2,10">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <TextBlock Text="Conversation"
                     FontSize="16" FontWeight="SemiBold"
                     Foreground="{StaticResource PeggyTextBrush}"/>
          <TextBlock Grid.Column="1"
                     Text="Read-only context"
                     FontSize="11"
                     Foreground="{StaticResource PeggyMutedTextBrush}"
                     VerticalAlignment="Center"/>
        </Grid>
        <Border x:Name="ContextStatusCard"
                Background="{StaticResource PeggyWarningSurfaceBrush}"
                BorderBrush="#E7CE79"
                BorderThickness="1" CornerRadius="10"
                Padding="11" Margin="0,0,0,12">
          <TextBlock x:Name="ContextStatus"
                     TextWrapping="Wrap"
                     Foreground="{StaticResource PeggyWarningBrush}"/>
        </Border>
        <StackPanel x:Name="MessagesPanel"/>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2"
            Background="{StaticResource PeggySurfaceBrush}"
            BorderBrush="{StaticResource PeggyBorderBrush}"
            BorderThickness="0,1,0,0"
            Padding="16,12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="Source context"
                     FontWeight="SemiBold" FontSize="12"
                     Foreground="{StaticResource PeggyTextBrush}"/>
          <TextBlock
              Text="Read-only content from Outlook or Microsoft Teams"
              Foreground="{StaticResource PeggyMutedTextBrush}"
              FontSize="11" Margin="0,2,14,0"/>
        </StackPanel>
        <Button x:Name="OpenOriginalButton" Grid.Column="1"
                Content="Open original"
                Style="{StaticResource PeggyPrimaryButtonStyle}"
                Visibility="Collapsed"
                Click="OpenOriginal_Click"/>
      </Grid>
    </Border>
  </Grid>
</Window>
