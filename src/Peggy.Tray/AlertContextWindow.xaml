<Window x:Class="Peggy.Tray.AlertContextWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Peggy alert context" Width="680" Height="720"
        MinWidth="520" MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="#f4f1ec" ShowInTaskbar="False">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Grid.Row="0" Background="#513b32" Padding="18,14">
      <DockPanel>
        <Button DockPanel.Dock="Right" Content="Close" Padding="14,6"
                VerticalAlignment="Center" Click="Close_Click"/>
        <StackPanel>
          <TextBlock x:Name="TitleText" Text="Alert context"
                     Foreground="White" FontSize="21"
                     FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="MetaText" Foreground="#eadfd8"
                     FontSize="12" Margin="0,3,0,0"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="18">
        <TextBlock x:Name="ReasonHeading" Text="Why Peggy alerted you"
                   FontSize="14"
                   FontWeight="SemiBold" Foreground="#513b32"
                   Margin="0,0,0,8"/>
        <Border Background="White" BorderBrush="#d8cec6"
                BorderThickness="1" CornerRadius="10"
                Padding="14" Margin="0,0,0,18">
          <StackPanel>
            <TextBlock x:Name="SummaryText" TextWrapping="Wrap"
                       FontSize="15" FontWeight="SemiBold"
                       Foreground="#2d2a27"/>
            <TextBlock x:Name="ReasonText" TextWrapping="Wrap"
                       FontSize="12" Foreground="#62564f"
                       Margin="0,7,0,0"/>
          </StackPanel>
        </Border>

        <TextBlock Text="Conversation" FontSize="14"
                   FontWeight="SemiBold" Foreground="#513b32"
                   Margin="0,0,0,8"/>
        <TextBlock x:Name="ContextStatus" TextWrapping="Wrap"
                   Foreground="#62564f" Margin="0,2,0,12"/>
        <StackPanel x:Name="MessagesPanel"/>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Background="#e9e2dc" Padding="14">
      <DockPanel>
        <Button x:Name="OpenOriginalButton" DockPanel.Dock="Right"
                Content="Open original" Padding="14,6"
                Visibility="Collapsed" Click="OpenOriginal_Click"/>
        <TextBlock Text="Read-only context from Outlook or Microsoft Teams."
                   VerticalAlignment="Center" Foreground="#62564f"
                   Margin="0,0,12,0"/>
      </DockPanel>
    </Border>
  </Grid>
</Window>
