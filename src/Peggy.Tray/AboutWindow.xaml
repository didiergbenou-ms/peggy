<Window x:Class="Peggy.Tray.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Peggy"
        Width="440"
        Height="300"
        MinWidth="340"
        MinHeight="300"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False"
        Background="{DynamicResource PeggyPageBrush}"
        FontFamily="Segoe UI"
        TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="PeggyTheme.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <Grid Background="{StaticResource PeggyPageBrush}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>
    <Border Background="{StaticResource PeggyHeaderBrush}" Padding="24,18">
      <StackPanel>
        <TextBlock Text="Peggy"
                   Foreground="White"
                   FontSize="23"
                   FontWeight="SemiBold"/>
        <TextBlock Text="Your work, sorted by what matters"
                   Foreground="#EADFD8"
                   FontSize="12"
                   Margin="0,3,0,0"/>
      </StackPanel>
    </Border>
    <StackPanel Grid.Row="1" Margin="24,18,24,10">
      <TextBlock Text="Release version"
                 Foreground="{StaticResource PeggyTextBrush}"
                 FontWeight="SemiBold"
                 Margin="0,0,0,7"/>
      <TextBox x:Name="VersionText"
               IsReadOnly="True"
               AutomationProperties.Name="Peggy release version"/>
      <TextBlock x:Name="CopyStatusText"
                 Foreground="{StaticResource PeggyMutedTextBrush}"
                 FontSize="11"
                 TextWrapping="Wrap"
                 Margin="0,7,0,0"
                 AutomationProperties.LiveSetting="Polite"/>
    </StackPanel>
    <StackPanel Grid.Row="2"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                Margin="24,0,24,18">
      <Button x:Name="CopyVersionButton"
              Content="Copy version"
              Margin="0,0,8,0"
              Click="CopyVersion_Click"/>
      <Button Content="Close" IsCancel="True" Click="Close_Click"/>
    </StackPanel>
  </Grid>
</Window>
